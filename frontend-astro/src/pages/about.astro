---
import BaseLayout from '../layouts/BaseLayout.astro';
import { breadcrumbJsonLd, buildMeta, organizationJsonLd, SITE_URL } from '../lib/seo';

const seo = buildMeta({
  title: 'About Pinpoint Answer Today',
  description: 'Learn what Pinpoint Answer Today publishes, how dated puzzle guides are structured, and how to request a correction.',
  canonical: `${SITE_URL}/about`,
  ogType: 'website',
  jsonLd: [
    organizationJsonLd(),
    breadcrumbJsonLd([{ name: 'Home', url: SITE_URL }, { name: 'About', url: `${SITE_URL}/about` }]),
    { '@context': 'https://schema.org', '@type': 'AboutPage', name: 'About Pinpoint Answer Today', description: 'About this independent puzzle reference and its publishing standards.', url: `${SITE_URL}/about`, dateModified: '2026-07-28' }
  ]
});
---
<BaseLayout {...seo}>
  <div class="container">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="separator" aria-hidden="true">/</span><span class="current">About</span>
    </nav>
  </div>

  <div class="content-page container">
    <h1>About Pinpoint Answer Today</h1>
    <p class="page-desc">Last updated: July 28, 2026. Pinpoint Answer Today is an independent reference for daily word-association puzzles.</p>

    <h2>What This Site Publishes</h2>
    <p>Every dated puzzle guide brings the puzzle number, date, clues, spoiler-protected answer, and connection explanation onto one indexable page. The goal is to provide useful context rather than publish an answer word without showing why it fits.</p>
    <p>The archive offers permanent links for historical puzzles, while the unlimited practice mode lets visitors work through past clue sets without waiting for the next daily release.</p>

    <h2>Publisher</h2>
    <p>Articles and puzzle guides are published by <strong>Pinpoint Answer Today</strong> as an organization; no individual author identity or personal credentials are claimed. Questions and correction reports go directly to <a href="mailto:contact@pinpointanswertoday.online">contact@pinpointanswertoday.online</a>.</p>

    <h2>How Guides Are Structured</h2>
    <p>Puzzle facts are stored with their date and puzzle number. The site then publishes each entry at a stable dated URL, presents the complete clue set, and adds an explanation focused on the relationships visible in that specific puzzle. Large alternative-solution lists are loaded separately so they do not make the article HTML unnecessarily heavy.</p>

    <h2>Standards and Corrections</h2>
    <p>Our <a href="/editorial-policy">editorial policy</a> documents sourcing, publication standards, advertising separation, and corrections. If a clue, date, answer, or explanation appears wrong, send the page URL and puzzle number through the <a href="/contact">contact page</a>. Valid fixes are applied to the affected dated guide.</p>

    <h2>Independence</h2>
    <p>Pinpoint Answer Today is not affiliated with, endorsed by, sponsored by, or operated by LinkedIn or Microsoft. Company and game names are used descriptively to identify the subject of the guides. See the full <a href="/disclaimer">independence and trademark disclaimer</a>.</p>
  </div>
</BaseLayout>
