---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerReveal from '../components/AnswerReveal.svelte';
import SolutionsLoader from '../components/SolutionsLoader.svelte';
import { formatDate, renderExplanation } from '../lib/api';
import { articleJsonLd, breadcrumbJsonLd, buildMeta, faqJsonLd, puzzlePermalink, SITE_URL, TODAY_FEATURED_IMAGE } from '../lib/seo';
import fs from 'fs';
import path from 'path';

interface Puzzle {
  number: number;
  date: string;
  clues: string[];
  answer: string | null;
  explanation?: string | null;
  solutions?: string[];
  totalSolutions?: number;
}

export function getStaticPaths() {
  const archivePath = path.join(process.cwd(), 'public/data/archive.json');
  const fullPath = path.join(process.cwd(), 'public/data/archive-full.json');
  let archive: Puzzle[] = [];
  let fullArchive: Puzzle[] = [];

  try {
    archive = JSON.parse(fs.readFileSync(archivePath, 'utf-8'));
    fullArchive = JSON.parse(fs.readFileSync(fullPath, 'utf-8'));
  } catch (error: any) {
    console.error(`[permalink] Failed to read archive data: ${error.message}`);
  }

  const fullByNumber = new Map(fullArchive.map(puzzle => [puzzle.number, puzzle]));
  return archive
    .filter(puzzle => puzzle.answer)
    .map(puzzle => ({
      // FIX 1.3: puzzlePermalink now returns trailing slash, so slice(1) still works
      params: { permalink: puzzlePermalink(puzzle.date).slice(1) },
      props: { puzzle: { ...puzzle, ...fullByNumber.get(puzzle.number) } }
    }));
}

const { puzzle } = Astro.props as { puzzle: Puzzle };
const answer = puzzle.answer || 'Answer unavailable';
const dateLabel = formatDate(puzzle.date);
const canonicalPath = puzzlePermalink(puzzle.date);
const canonicalUrl = `${SITE_URL}${canonicalPath}`;
const explanationWordCount = puzzle.explanation?.trim().split(/\s+/).filter(Boolean).length || 0;

// FIX 3.4: Title includes "LinkedIn Pinpoint", puzzle number, date, and answer
const title = `LinkedIn Pinpoint Answer for ${dateLabel} — Puzzle #${puzzle.number}: ${answer}`;
const description = `The LinkedIn Pinpoint answer for ${dateLabel} (puzzle #${puzzle.number}) is ${answer}. See all ${puzzle.clues.length} clues explained and the solving strategy.`;

// FIX 3.5: FAQPage schema for "People also ask" boxes and featured snippets
const faqSchema = faqJsonLd([
  {
    question: `What is the LinkedIn Pinpoint answer for ${dateLabel}?`,
    answer: `The LinkedIn Pinpoint answer for ${dateLabel} (puzzle #${puzzle.number}) is "${answer}". The five clues were: ${puzzle.clues.join(', ')}.`
  },
  {
    question: `What are the clues for LinkedIn Pinpoint #${puzzle.number}?`,
    answer: `The ${puzzle.clues.length} clues for LinkedIn Pinpoint puzzle #${puzzle.number} are: ${puzzle.clues.map((c, i) => `(${i+1}) ${c}`).join('; ')}. All clues point to the answer "${answer}".`
  },
  {
    question: `How do I solve LinkedIn Pinpoint #${puzzle.number}?`,
    answer: `To solve LinkedIn Pinpoint puzzle #${puzzle.number}, read each clue and look for the common theme. The answer "${answer}" connects all ${puzzle.clues.length} clues. See the detailed clue-by-clue explanation above.`
  },
  {
    question: `What was the LinkedIn Pinpoint answer on ${dateLabel}?`,
    answer: `On ${dateLabel}, the LinkedIn Pinpoint answer was "${answer}" (puzzle #${puzzle.number}). The clues were ${puzzle.clues.join(', ')}.`
  }
]);

const seo = buildMeta({
  title,
  description,
  canonical: canonicalUrl,
  ogImage: TODAY_FEATURED_IMAGE,
  ogType: 'article',
  jsonLd: [
    articleJsonLd({
      title,
      description,
      url: canonicalUrl,
      datePublished: puzzle.date,
      answer,
      number: puzzle.number,
      wordCount: explanationWordCount
    }),
    breadcrumbJsonLd([
      { name: 'Home', url: SITE_URL },
      { name: 'Archive', url: `${SITE_URL}/archive/` },
      { name: `Puzzle #${puzzle.number}`, url: canonicalUrl }
    ]),
    // FIX 3.5: FAQPage schema — captures "People also ask" and featured snippets
    faqSchema
  ]
});

// FIX 3.7: Last updated timestamp
const lastUpdated = puzzle.date;
---
<BaseLayout {...seo} articlePublishedTime={puzzle.date}>
  <article class="puzzle-page">
    <div class="container">
      <div style="max-width:720px; margin:0 auto;">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a>
          <span class="separator" aria-hidden="true">/</span>
          <a href="/archive/">Archive</a>
          <span class="separator" aria-hidden="true">/</span>
          <span class="current">Puzzle #{puzzle.number}</span>
        </nav>

        <header class="puzzle-header">
          <span class="badge badge-primary">Archive guide</span>
          <h1>LinkedIn Pinpoint #{puzzle.number} Answer for {dateLabel}</h1>
          <p class="puzzle-date-row"><time datetime={puzzle.date}>{dateLabel}</time></p>
          <p class="last-updated" style="font-size: 0.85em; color: var(--text-muted, #666);">Last updated: {dateLabel}</p>
          <p>This dated guide records every clue, the spoiler-protected answer, and an explanation of the connection for puzzle #{puzzle.number}.</p>
        </header>

        <!-- FIX 5.3: Featured snippet optimization — direct answer in <p> right after H1 -->
        <section class="quick-answer" style="background: var(--card-bg, #f5f5f5); padding: 1em 1.5em; border-radius: 8px; margin: 1em 0;">
          <h2 style="margin-top: 0; font-size: 1.1em;">Quick Answer</h2>
          <p><strong>The LinkedIn Pinpoint answer for {dateLabel} (Puzzle #{puzzle.number}) is: {answer}</strong></p>
          <p>The {puzzle.clues.length} clues are: {puzzle.clues.join(', ')}.</p>
        </section>

        <section aria-labelledby="clues-heading">
          <h2 id="clues-heading" class="clues-heading">Puzzle #{puzzle.number} Clues</h2>
          <ol class="clues-list">
            {puzzle.clues.map((clue, index) => (
              <li class="clue-item">
                <span class="clue-number">{index + 1}</span>
                <span class="clue-text">{clue}</span>
              </li>
            ))}
          </ol>
        </section>

        <AnswerReveal client:load answer={answer} />

        {puzzle.explanation ? (
          <section class="explanation-section" aria-labelledby="explanation-heading">
            <h2 id="explanation-heading">Why {answer} Connects the Clues</h2>
            <div class="explanation-content" itemprop="articleBody">
              <Fragment set:html={renderExplanation(puzzle.explanation)} />
            </div>
          </section>
        ) : (
          <section class="card mt-3" aria-labelledby="connection-summary-heading">
            <h2 id="connection-summary-heading">Connection Summary</h2>
            <p>The answer recorded for this puzzle is <strong>{answer}</strong>. Compare it with the five clues above to see the shared category or phrase pattern. A longer clue-by-clue explanation is not yet available for this archived entry.</p>
          </section>
        )}

        {(puzzle.totalSolutions || 0) > 0 && (
          <SolutionsLoader client:visible puzzleNumber={puzzle.number} initialSolutions={puzzle.solutions || []} totalSolutions={puzzle.totalSolutions || 0} />
        )}

        <!-- FIX 5.3: FAQ section in the visible HTML (not just schema) for featured snippets -->
        <section class="faq-section mt-3" aria-labelledby="faq-heading">
          <h2 id="faq-heading">Frequently Asked Questions</h2>
          <h3>What is the LinkedIn Pinpoint answer for {dateLabel}?</h3>
          <p>The LinkedIn Pinpoint answer for {dateLabel} (puzzle #{puzzle.number}) is "{answer}". The five clues were: {puzzle.clues.join(', ')}.</p>

          <h3>What are the clues for LinkedIn Pinpoint #{puzzle.number}?</h3>
          <p>The {puzzle.clues.length} clues for LinkedIn Pinpoint puzzle #{puzzle.number} are: {puzzle.clues.map((c, i) => `(${i+1}) ${c}`).join('; ')}. All clues point to the answer "{answer}".</p>

          <h3>How do I solve LinkedIn Pinpoint #{puzzle.number}?</h3>
          <p>To solve LinkedIn Pinpoint puzzle #{puzzle.number}, read each clue and look for the common theme. The answer "{answer}" connects all {puzzle.clues.length} clues. See the detailed clue-by-clue explanation above.</p>
        </section>

        <aside class="card mt-3">
          <h2>About This Guide</h2>
          <p>Pinpoint Answer Today is an independent puzzle resource and is not affiliated with, endorsed by, or sponsored by LinkedIn or Microsoft. See our <a href="/editorial-policy/">editorial policy</a> for sourcing and corrections.</p>
        </aside>
      </div>
    </div>
  </article>
</BaseLayout>
