---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnswerReveal from '../components/AnswerReveal.svelte';
import SolutionsLoader from '../components/SolutionsLoader.svelte';
import { formatDate, renderExplanation, getExplanationHeadings } from '../lib/api';
import { buildMeta, articleJsonLd, breadcrumbJsonLd, faqJsonLd, puzzlePermalink, SITE_URL, TODAY_FEATURED_IMAGE } from '../lib/seo';
import fs from 'fs';
import path from 'path';

let today: any = null;
let yesterday: any = null;
let error: string | null = null;

try {
  const todayPath = path.join(process.cwd(), 'public/data/today.json');
  const raw = fs.readFileSync(todayPath, 'utf-8');
  const parsed = JSON.parse(raw);
  if (parsed && parsed.number && parsed.answer) {
    today = parsed;
  } else {
    today = null;
    error = 'Today\'s puzzle data is being updated. Please check back shortly.';
  }
} catch (e) {
  error = 'Today\'s puzzle data is being updated. Please check back shortly.';
}

try {
  const yesterdayPath = path.join(process.cwd(), 'public/data/yesterday.json');
  const raw = fs.readFileSync(yesterdayPath, 'utf-8');
  yesterday = JSON.parse(raw);
  if (!yesterday || !yesterday.number) yesterday = null;
} catch (e) { /* Not critical */ }

const shortDateStr = today
  ? new Date(today.date + 'T00:00:00').toLocaleDateString('en-US', {
      month: 'long',
      day: 'numeric',
      year: 'numeric'
    })
  : 'Today';

const explanationWordCount = today?.explanation
  ? today.explanation.trim().split(/\s+/).filter(Boolean).length
  : undefined;
const explanationHeadings = today?.explanation ? getExplanationHeadings(today.explanation) : [];

// SEO-optimized title: "LinkedIn Pinpoint Answer with Explanation - Daily Solution"
const title = 'LinkedIn Pinpoint Answer with Explanation - Daily Solution';

// SEO-optimized meta description (within Google's ~155 char limit)
// Includes "pinpoint answer today" with game number and date for extra keyword traffic
const descriptionText = today
  ? `LinkedIn Pinpoint answer today with explanation for game #${today.number} (${shortDateStr}). See all clues, solving strategy, and daily solution.`
  : `LinkedIn Pinpoint answer today with explanation. See all clues, solving strategy, and daily solution breakdown.`;

// SEO-optimized meta keywords
const keywords = 'LinkedIn Pinpoint answer with explanation, Pinpoint answer today, daily solution, LinkedIn Pinpoint clues, Pinpoint solving strategy, daily puzzle solution, Pinpoint explanation';

// Intro text includes "pinpoint answer today" with game number and date for extra keyword traffic
const introText = today
  ? `Pinpoint answer today for game #${today.number} (${shortDateStr}). This page covers clue meanings, explanations, solving tips, strategies, and the full archive.`
  : "If you are looking for the LinkedIn Pinpoint answer today, this page gives you the clues, explanations, solving tips, strategies, and archive in one place.";


const seo = buildMeta({
  title,
  description: descriptionText,
  keywords,
  canonical: `${SITE_URL}/today/`,
  ogImage: TODAY_FEATURED_IMAGE,
  ogType: 'article',
  jsonLd: [
    articleJsonLd({
      title,
      description: today
        ? `LinkedIn Pinpoint answer today for ${shortDateStr} and puzzle #${today.number}, with clues, explanations, word meanings, tips, strategies, and archive access.`
        : "Today's LinkedIn Pinpoint answer",
      url: `${SITE_URL}/today/`,
      datePublished: today?.date || new Date().toISOString().split('T')[0],
      answer: today?.answer || '',
      number: today?.number || 0,
      wordCount: explanationWordCount
    }),

    breadcrumbJsonLd([
      { name: 'Home', url: SITE_URL },
      { name: "Today's Answer", url: `${SITE_URL}/today/` }
    ]),

    // FIX 3.5: FAQPage schema on /today page for "People also ask" boxes
    faqJsonLd(today ? [
      { question: `What is the LinkedIn Pinpoint answer for ${shortDateStr}?`, answer: `The LinkedIn Pinpoint answer for ${shortDateStr} (puzzle #${today.number}) is "${today.answer}".` },
      { question: 'What time does the new LinkedIn Pinpoint puzzle come out?', answer: `New LinkedIn Pinpoint puzzles are released daily. Our answer for puzzle #${today.number} is published by 1:30 PM IST each day.` },
      { question: `How many clues are in LinkedIn Pinpoint #${today.number}?`, answer: `LinkedIn Pinpoint #${today.number} has ${today.clues?.length || 5} clues. The answer "${today.answer}" connects all of them.` }
    ] : [
      { question: 'What is the LinkedIn Pinpoint answer today?', answer: "See the answer revealed above on this page, updated daily." }
    ])
  ]
});
---
<BaseLayout {...seo} articlePublishedTime={today?.date}>
  {error && !today ? (
    <section class="section">
      <div class="container">
        <div class="error-state">
          <h3>Today's Puzzle</h3>
          <p>{error}</p>
          <p style="color:var(--text-muted); font-size:0.85rem; margin-top:0.5rem;">New puzzles appear after 1:30 PM IST. If it is past that time, a site rebuild is likely in progress - check back in a few minutes.</p>
          <div style="margin-top:1rem; display:flex; gap:0.5rem; flex-wrap:wrap;">
            <a href="/archive/" class="btn btn-secondary btn-sm">Browse Archive</a>
            <a href="/unlimited/" class="btn btn-secondary btn-sm">Play Unlimited</a>
          </div>
        </div>
      </div>
    </section>
  ) : today && (
    <div class="puzzle-page">
      <div class="container">
        <div style="max-width:720px; margin:0 auto;">
          <nav class="breadcrumbs" aria-label="Breadcrumb">
            <a href="/">Home</a>
            <span class="separator" aria-hidden="true">/</span>
            <span class="current">Today's Answer</span>
          </nav>

          <div class="puzzle-header">
            <span class="badge badge-primary">Updated today</span>
            <h1>{title}</h1>
            <p class="puzzle-date-row">
              <span>{shortDateStr}</span>
              <span aria-hidden="true">•</span>
              <span>Game {today.number}</span>
            </p>
            <p class="last-updated" style="font-size: 0.85em; color: var(--text-muted, #666); margin: 0.25rem 0;">Last updated: {shortDateStr}</p>
            <p style="margin:0.65rem 0 0; color:var(--text-secondary); font-size:0.95rem; line-height:1.7;">{introText}</p>
          </div>

          <figure class="today-featured-image">
            <img
              src="/pinpoint-answer-today.webp"
              alt={today ? `Pinpoint answer guide for ${shortDateStr}, puzzle ${today.number}` : 'Pinpoint answer guide'}
              width="1200"
              height="630"
              loading="eager"
              decoding="async"
            />
            <figcaption>
              <span class="today-featured-pill">Updated today</span>
              <span>{shortDateStr}</span>
              <span aria-hidden="true">•</span>
              <span>Game {today.number}</span>
            </figcaption>
          </figure>

          <section aria-labelledby="clues-heading">
            <h2 id="clues-heading" class="clues-heading">
              <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
              Pinpoint #{today.number} Clues
            </h2>
            <ul class="clues-list">
              {today.clues.map((clue: string, i: number) => (
                <li class="clue-item">
                  <span class="clue-number">{i + 1}</span>
                  <span class="clue-text">{clue}</span>
                </li>
              ))}
            </ul>
          </section>

          <AnswerReveal client:load answer={today.answer} />

          <SolutionsLoader client:visible puzzleNumber={today.number} initialSolutions={today.solutions || []} totalSolutions={today.totalSolutions || 0} />

          {explanationHeadings.length > 0 && (
            <section class="puzzle-toc" aria-labelledby="toc-heading">
              <div class="puzzle-toc-header">
                <span class="puzzle-toc-kicker">Quick navigation</span>
                <h2 id="toc-heading">Table of contents</h2>
              </div>
              <ul class="puzzle-toc-list">
                <li class="puzzle-toc-item puzzle-toc-item-main">
                  <a href="#explanation-heading">Pinpoint answer today with explanations and meaning</a>
                </li>
                {explanationHeadings.map((heading) => (
                  <li class={`puzzle-toc-item level-${heading.level}`}>
                    <a href={`#${heading.id}`}>{heading.text}</a>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {today.explanation && (
            <section class="explanation-section" aria-labelledby="explanation-heading">
              <h2 id="explanation-heading">
                <span class="icon-circle">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/></svg>
                </span>
                Pinpoint answer today with explanations and meaning
              </h2>
              <div class="explanation-content" itemprop="articleBody">
                <Fragment set:html={renderExplanation(today.explanation)} />
              </div>
            </section>
          )}

          {yesterday && (
            <div class="card mt-3" style="border-left: 3px solid var(--accent-500);">
              <div style="display:inline-flex; align-items:center; gap:0.5rem; margin-bottom:0.25rem;">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"/></svg>
                <h3 style="font-size:0.85rem; font-weight:700; margin:0;">Previous Puzzle</h3>
              </div>
              <p style="font-size:0.85rem;">
                <a href={puzzlePermalink(yesterday.date)}>
                  Pinpoint #{yesterday.number} ({formatDate(yesterday.date)}) - Answer: <strong>{yesterday.answer}</strong>
                </a>
              </p>
            </div>
          )}
        </div>
      </div>
    </div>
  )}
</BaseLayout>